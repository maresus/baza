# ============================================================
# KOVAČNIK AI - Email konfiguracija
# ============================================================
# 
# STANJE: NEAKTIVNO
# Ko boš pripravljen za aktivacijo:
# 1. Izpolni spodnje vrednosti
# 2. Preimenuj v .env (odstrani .example)
# 3. V chat_router.py odkomentiraj email klice
#
# ============================================================

# SMTP nastavitve (uporabi iste kot WP Mail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@kovacnik.com
SMTP_PASSWORD=your_app_password_here

# Pošiljatelj
SMTP_FROM_EMAIL=info@kovacnik.com
SMTP_FROM_NAME=Domačija Kovačnik

# Admin prejemnik (za obvestila o novih rezervacijah)
ADMIN_EMAIL=info@kovacnik.com

# ============================================================
# Smoke test - dnevno poročilo
# ============================================================
# SMOKE_BASE_URL=https://kovacnik-ai-production.up.railway.app
# SMOKE_QUESTIONS_PATH=data/smoke_questions.txt
# SMOKE_EMAIL_TO=info@kovacnik.com
# SMOKE_EMAIL_MODE=errors  # errors | always
# SMOKE_TIMEOUT_SEC=12

# ============================================================
# Ostale nastavitve (že obstoječe)
# ============================================================
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
